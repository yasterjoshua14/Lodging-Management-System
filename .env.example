CI_ENVIRONMENT=production

# If Vercel system variables are exposed, the app can fall back to VERCEL_URL.
# Set this explicitly when using a custom domain.
APP_BASE_URL=https://your-project.vercel.app/
APP_FORCE_HTTPS=false

DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PORT=3306
DATABASE_DRIVER=MySQLi

# Optional: DATABASE_URL can be used instead of the individual DATABASE_* values.
# DATABASE_URL=mysql://user:password@host:3306/database

# Recommended for Vercel so auth survives serverless instance changes.
SESSION_DRIVER=database
SESSION_SAVE_PATH=ci_sessions

PAYMONGO_SECRET_KEY=
PAYMONGO_PAYMENT_METHOD_TYPES=gcash,paymaya,card
PAYMONGO_MERCHANT_NAME=Lodging Management System
PAYMONGO_SEND_EMAIL_RECEIPT=false
PAYMONGO_BASE_URI=https://api.paymongo.com/v1/
